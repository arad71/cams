# ═══════════════════════════════════════════════════════════
#  CAMS Production Environment — External Database
#  Copy: cp .env.production.example .env
#  Then edit with your actual values
# ═══════════════════════════════════════════════════════════

# ─── External Database (Azure Postgres Flexible Server) ───
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://camsadmin:CHANGE_ME_strong_password@cams-db.postgres.database.azure.com:5432/cams_approval?sslmode=require

# ─── Backend ──────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_64_random_chars

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3001,https://crossover.council.wa.gov.au

# Number of API worker processes (2 per CPU core)
API_WORKERS=2

# ─── AI / Document Analysis ──────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
AI_MODEL_DEFAULT=claude-sonnet-4-20250514
PDF_RENDER_DPI=200
MAX_IMAGE_DIM=2048
AI_MAX_TOKENS=4096

# ─── Frontend ─────────────────────────────────────────────
FRONTEND_PORT=3001

# ─── Microsoft Entra ID (Azure AD) SSO ───────────────────
ENTRA_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=https://crossover.council.wa.gov.au/
ENTRA_AUTO_CREATE_USER=true
ENTRA_DEFAULT_ROLE=engineer
