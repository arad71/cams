# ═══════════════════════════════════════════════════════════
#  CAMS — TEST Environment
#  Database: Docker container (included in docker-compose)
#  Usage:
#    cp .env.test .env
#    docker compose -f docker-compose.prod.yml up -d --build
# ═══════════════════════════════════════════════════════════

# ─── Database (Docker container) ──────────────────────────
POSTGRES_DB=cams_approval
POSTGRES_USER=cams
POSTGRES_PASSWORD=CamsTest2026!secure

# ─── Backend ──────────────────────────────────────────────
# IMPORTANT: Generate a unique key for each environment
# Run: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_with_command_above

# Allow all origins for testing (restrict in production)
CORS_ORIGINS=*

# Workers (1-2 for test VM)
API_WORKERS=2

# Debug mode (true for test, false for production)
DEBUG=true

# ─── AI / Document Analysis ──────────────────────────────
# Optional — system works without it, AI analysis disabled
ANTHROPIC_API_KEY=
AI_MODEL_DEFAULT=claude-sonnet-4-20250514
PDF_RENDER_DPI=200
MAX_IMAGE_DIM=2048
AI_MAX_TOKENS=4096

# ─── Frontend ─────────────────────────────────────────────
FRONTEND_PORT=3001

# ─── GeoData / Data WA SLIP ──────────────────────────────
# Bounding box for spatial queries (xmin,ymin,xmax,ymax — EPSG:7844)
COUNCIL_BBOX=115.95,-32.10,116.15,-31.87
COUNCIL_LGA_NAME=Kalamunda
COUNCIL_LGA_NO=102
# Output directory for GeoJSON files (default: approval-frontend/public/)
# GEOJSON_OUTPUT_DIR=

# ─── Microsoft Entra ID SSO (disabled for testing) ───────
ENTRA_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:3001/
ENTRA_AUTO_CREATE_USER=true
ENTRA_DEFAULT_ROLE=engineer

# ─── Test Accounts (seeded automatically) ─────────────────
# admin@council.wa.gov.au     / admin123
# manager@council.wa.gov.au   / manager123
# engineer@council.wa.gov.au  / engineer123
# engineer2@council.wa.gov.au / engineer123
# viewer@council.wa.gov.au    / viewer123
