# CAMS Environment Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Anthropic API Key — required for AI Live site plan extraction
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# AI Model (optional — defaults to claude-sonnet-4-20250514)
# Options: claude-sonnet-4-20250514, claude-haiku-4-5-20251001
#AI_MODEL_DEFAULT=claude-sonnet-4-20250514

# PDF rendering (optional)
#PDF_RENDER_DPI=200
#MAX_IMAGE_DIM=2048
#AI_MAX_TOKENS=4096
