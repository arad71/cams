# ═══════════════════════════════════════════════════════════
#  CAMS Production Environment Variables
#  Copy this file: cp .env.example .env
#  Then edit .env with your actual values
# ═══════════════════════════════════════════════════════════

# ─── Database ──────────────────────────────────────────
POSTGRES_DB=cams_approval
POSTGRES_USER=cams
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ─── Backend ──────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_64_random_chars

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3001,https://crossover.kalamunda.wa.gov.au

# Number of API worker processes (2 per CPU core is a good starting point)
API_WORKERS=2

# ─── AI / Document Analysis ──────────────────────────
# Anthropic API key for site plan AI analysis (optional — system works without it)
ANTHROPIC_API_KEY=
AI_MODEL_DEFAULT=claude-sonnet-4-20250514
PDF_RENDER_DPI=200
MAX_IMAGE_DIM=2048
AI_MAX_TOKENS=4096

# ─── Frontend ──────────────────────────────────────────
# Port the approval portal is exposed on
FRONTEND_PORT=3001

# ─── Microsoft Entra ID (Azure AD) SSO ────────────────
# Set ENTRA_ENABLED=true to show "Sign in with Microsoft" button
# Register an App in Azure Portal → App registrations → New registration
#   - Redirect URI: https://crossover.kalamunda.wa.gov.au/ (or http://localhost:3001/ for dev)
#   - Supported account types: Single tenant (this organisation only)
#   - API permissions: openid, profile, email
ENTRA_ENABLED=false
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:3001/
ENTRA_AUTO_CREATE_USER=true
ENTRA_DEFAULT_ROLE=engineer
