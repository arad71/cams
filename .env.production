# ═══════════════════════════════════════════════════════════
#  CAMS — PRODUCTION Environment
#  Database: Azure PostgreSQL Flexible Server (external)
#  Usage:
#    cp .env.production .env
#    docker compose -f docker-compose.external-db.yml up -d --build
# ═══════════════════════════════════════════════════════════

# ─── External Database ────────────────────────────────────
# Azure PostgreSQL Flexible Server connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://camsadmin:CHANGE_ME@cams-db.postgres.database.azure.com:5432/cams_approval?sslmode=require

# ─── Backend ──────────────────────────────────────────────
# IMPORTANT: Generate a UNIQUE key (different from test!)
# Run: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_with_command_above

# Restrict to your domain only
CORS_ORIGINS=https://crossover.council.wa.gov.au

# Workers (2-4 for production)
API_WORKERS=4

# Debug mode OFF for production
DEBUG=false

# ─── AI / Document Analysis ──────────────────────────────
# Required for site plan AI analysis in production
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME
AI_MODEL_DEFAULT=claude-sonnet-4-20250514
PDF_RENDER_DPI=200
MAX_IMAGE_DIM=2048
AI_MAX_TOKENS=4096

# ─── Frontend ─────────────────────────────────────────────
FRONTEND_PORT=3001

# ─── GeoData / Data WA SLIP ──────────────────────────────
COUNCIL_BBOX=115.95,-32.10,116.15,-31.87
COUNCIL_LGA_NAME=Kalamunda
COUNCIL_LGA_NO=102
# GEOJSON_OUTPUT_DIR=

# ─── Microsoft Entra ID SSO ──────────────────────────────
# Register app at: Azure Portal → App registrations → New
# Redirect URI: https://crossover.council.wa.gov.au/
# Permissions: openid, profile, email
ENTRA_ENABLED=true
ENTRA_TENANT_ID=CHANGE_ME
ENTRA_CLIENT_ID=CHANGE_ME
ENTRA_CLIENT_SECRET=CHANGE_ME
ENTRA_REDIRECT_URI=https://crossover.council.wa.gov.au/
ENTRA_AUTO_CREATE_USER=true
ENTRA_DEFAULT_ROLE=engineer
