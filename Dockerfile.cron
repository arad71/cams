FROM python:3.12-slim

WORKDIR /app
COPY scripts/update_geodata.py scripts/
COPY scripts/update_lots.py scripts/

# Install cron
RUN apt-get update && apt-get install -y --no-install-recommends cron && rm -rf /var/lib/apt/lists/*

# Create log and backup directories
RUN mkdir -p /var/log/cams /app/backups/geojson

# Cron jobs:
#   Sunday 2am    — full refresh (lots + roads + speed limits)
#   Wednesday 2am — lots only (most frequently updated layer)
RUN echo "0 2 * * 0 cd /app && python scripts/update_geodata.py >> /var/log/cams/geodata_update.log 2>&1" > /etc/cron.d/geodata-update \
    && echo "0 2 * * 3 cd /app && python scripts/update_geodata.py --layer lots >> /var/log/cams/geodata_update.log 2>&1" >> /etc/cron.d/geodata-update \
    && chmod 0644 /etc/cron.d/geodata-update \
    && crontab /etc/cron.d/geodata-update

CMD ["cron", "-f"]
