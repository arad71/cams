FROM python:3.12-slim

WORKDIR /app
COPY scripts/update_lots.py scripts/
COPY approval-frontend/public/lot.geojson approval-frontend/public/lot.geojson

# Install cron
RUN apt-get update && apt-get install -y --no-install-recommends cron && rm -rf /var/lib/apt/lists/*

# Create log directory
RUN mkdir -p /var/log/cams

# Cron job: every Sunday at 2am
RUN echo "0 2 * * 0 cd /app && python scripts/update_lots.py >> /var/log/cams/lot_update.log 2>&1" > /etc/cron.d/lot-update \
    && chmod 0644 /etc/cron.d/lot-update \
    && crontab /etc/cron.d/lot-update

CMD ["cron", "-f"]
